---
import Layout from '../layouts/Layout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.geocoded.me'
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || 'https://github.com/geocoded-me/geocoded'

const features = [
	{
		title: 'Public by default',
		description: 'No signup and no API key. Clean JSON for apps, scripts, dashboards, and internal tools.',
		number: '01'
	},
	{
		title: 'Root collections',
		description: 'Countries, states, cities, timezones, currencies, airports, ports, and more as first-class APIs.',
		number: '02'
	},
	{
		title: 'Query what you need',
		description: 'Use `filter[...]`, `fields`, `expand`, pagination, search, and sorting without changing endpoints.',
		number: '03'
	},
	{
		title: 'Edge cached',
		description: 'Cloudflare Workers and D1 keep reads fast, cacheable, and close to the caller.',
		number: '04'
	},
]

function jsonKv(k: string, v: string, last = false) {
	return `  <span class="text-white">"${k}"</span><span class="text-white/50">: </span><span class="text-white/80">"${v}"</span>${last ? '' : ','}\n`
}
function jsonKvi(k: string, v: string, last = false) {
	return `    <span class="text-white">"${k}"</span><span class="text-white/50">: </span><span class="text-white/80">"${v}"</span>${last ? '' : ','}\n`
}
function jsonKviRaw(k: string, v: string, last = false) {
	return `    <span class="text-white">"${k}"</span><span class="text-white/50">: </span>${v}${last ? '' : ','}\n`
}
function jsonBr(v: string) {
	return `<span class="text-white/50">${v}</span>\n`
}

const examples = [
	{
		title: 'Caller location',
		curl: `curl '${apiUrl}/v2?fields=ip,country,countryInfo.name'`,
		responseHtml:
			jsonBr('{') +
			jsonKv('ip', '203.0.113.42') +
			jsonKv('country', 'AE') +
			`  <span class="text-white">"countryInfo"</span><span class="text-white/50">: </span><span class="text-white/50">{</span>\n` +
			jsonKvi('name', 'United Arab Emirates', true) +
			`  <span class="text-white/50">}</span>\n` +
			jsonBr('}'),
	},
	{
		title: 'Filter countries',
		curl: `curl '${apiUrl}/v2/countries?filter[country]=AE&fields=id,iso2,name,currency'`,
		responseHtml:
			jsonBr('{') +
			`  <span class="text-white">"data"</span><span class="text-white/50">: </span><span class="text-white/50">[</span>\n` +
			jsonBr('  {') +
			jsonKvi('id', 'AE') +
			jsonKvi('iso2', 'AE') +
			jsonKvi('name', 'United Arab Emirates') +
			jsonKvi('currency', 'AED', true) +
			jsonBr('  }') +
			`  <span class="text-white/50">],</span>\n` +
			`  <span class="text-white">"meta"</span><span class="text-white/50">: </span><span class="text-white/80">{ "limit": 25, "offset": 0, "total": 1 }</span>\n` +
			jsonBr('}'),
	},
	{
		title: 'Expand statistics',
		curl: `curl '${apiUrl}/v2/countries?filter[country]=AE&expand=statistics&fields=*,statistics.gdpPerCapitaCurrentUsd'`,
		responseHtml:
			jsonBr('{') +
			`  <span class="text-white">"data"</span><span class="text-white/50">: </span><span class="text-white/50">[</span>\n` +
			jsonBr('  {') +
			jsonKvi('id', 'AE') +
			jsonKvi('name', 'United Arab Emirates') +
			jsonKvi('currency', 'AED') +
			`    <span class="text-white">"statistics"</span><span class="text-white/50">: </span><span class="text-white/50">{</span>\n` +
			`      <span class="text-white">"gdpPerCapitaCurrentUsd"</span><span class="text-white/50">: </span><span class="text-white/80">{ "year": 2024, "value": 53700 }</span>\n` +
			`    <span class="text-white/50">}</span>\n` +
			jsonBr('  }') +
			`  <span class="text-white/50">],</span>\n` +
			`  <span class="text-white">"meta"</span><span class="text-white/50">: </span><span class="text-white/80">{ ... }</span>\n` +
			jsonBr('}'),
	},
	{
		title: 'List cities',
		curl: `curl '${apiUrl}/v2/cities?filter[country]=AE&fields=id,name,countryCode,stateCode&limit=2'`,
		responseHtml:
			jsonBr('{') +
			`  <span class="text-white">"data"</span><span class="text-white/50">: </span><span class="text-white/50">[</span>\n` +
			jsonBr('  {') +
			jsonKvi('id', '292968') +
			jsonKvi('name', 'Abu Dhabi') +
			jsonKvi('countryCode', 'AE') +
			jsonKvi('stateCode', 'AZ', true) +
			jsonBr('  }') +
			`  <span class="text-white/50">],</span>\n` +
			`  <span class="text-white">"meta"</span><span class="text-white/50">: </span><span class="text-white/80">{ ... }</span>\n` +
			jsonBr('}'),
	},
]

const stats = [
	{ label: 'Countries', value: '252', suffix: '' },
	{ label: 'States', value: '5,084', suffix: '+' },
	{ label: 'Cities', value: '232K', suffix: '+' },
	{ label: 'Timezones', value: '312', suffix: '' },
]
---

<Layout title="Geocoded | Free Country, State, City & Location API" description="Free, fast REST API for country, state, city, and IP geolocation data. Powered by Cloudflare Workers with global edge caching.">
	<!-- Hero -->
	<div class="min-h-[70vh] flex flex-col justify-center items-start border-l border-white/20 pl-10 md:pl-20 mb-32 pt-20">
		<p class="text-lg font-bold tracking-widest text-white/40 uppercase mb-6 w-full">
			Global Geography Data API
		</p>
		<h1 class="text-6xl md:text-8xl lg:text-[10rem] font-bold tracking-tighter leading-[0.85] uppercase mb-8">
			Geocoded
		</h1>
		<p class="text-xl md:text-2xl font-light text-white/60 max-w-2xl leading-relaxed mb-16">
			Open-source geography API for location, administrative, transport,
			timezone, currency, and statistics data. No API key required.
		</p>

		<div class="flex flex-wrap gap-6">
			<a href="/docs" class="bg-white text-black px-10 py-5 rounded-none font-bold tracking-widest uppercase text-sm hover:bg-white/80 transition-colors">
				View API Docs
			</a>
			<a href={githubUrl} target="_blank" class="lux-panel px-10 py-5 rounded-none font-bold tracking-widest uppercase text-sm hover:bg-white/10 transition-colors flex items-center gap-3">
				<svg class="size-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
				GitHub
			</a>
		</div>
	</div>

	<!-- Stats Banner -->
	<div class="mb-24">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/20 border border-white/20">
			{stats.map((stat, i) => (
				<div class="bg-black p-8 md:p-12 relative overflow-hidden group">
					<div class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></div>
					<div class="text-sm font-bold text-white/40 tracking-widest uppercase mb-4">{stat.label}</div>
					<div class="stat-counter text-4xl md:text-6xl font-bold tracking-tighter" data-target={stat.value} data-suffix={stat.suffix} data-delay={i * 100}>
						{stat.value}{stat.suffix}
					</div>
				</div>
			))}
		</div>
	</div>

	<!-- Features Matrix -->
	<section class="mb-24 pt-12 border-t border-white/20">
		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-white/40">Why Geocoded</p>
		<h2 class="mb-6 text-4xl md:text-6xl font-bold tracking-tighter uppercase">One surface<br/><span class="text-white/40">many datasets</span></h2>
		<p class="mb-10 max-w-xl text-lg text-white/60 leading-relaxed">
			Use the same query model across reference data, administrative geography, transport, and statistics.
		</p>

		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/20 border border-white/20">
			{features.map((f) => (
				<div class="bg-black p-8 lg:p-10 min-h-[240px] group hover:bg-white/[0.02] transition-colors">
					<div class="mb-8 text-xs font-bold text-white/30 uppercase tracking-widest">{f.number}</div>
					<h3 class="text-2xl font-bold tracking-tighter uppercase mb-4">{f.title}</h3>
					<p class="text-white/60 text-base leading-relaxed">{f.description}</p>
				</div>
			))}
		</div>
	</section>

	<!-- Quick Start Examples -->
	<section class="mb-32 pt-12 border-t border-white/20" id="examples">
		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-white/40">Quick Start</p>
		<h2 class="mb-6 text-4xl md:text-6xl font-bold tracking-tighter uppercase">Simple endpoints<br/><span class="text-white/40">zero config</span></h2>
		<p class="mb-16 max-w-lg text-lg text-white/60 leading-relaxed">
			Every response is JSON with aggressive cache headers. Try these from your terminal right now.
		</p>

		<div class="flex flex-col gap-8">
			{examples.map((ex) => (
				<div class="lux-panel p-0 overflow-hidden flex flex-col md:flex-row">
					<div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-white/20 md:w-1/2 flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between mb-8">
								<h3 class="text-xl font-bold tracking-tighter uppercase text-white/80">{ex.title}</h3>
								<span class="rounded-none bg-white text-black px-2 py-1 text-[10px] font-bold tracking-widest uppercase">GET</span>
							</div>
							<p class="mb-4 text-xs font-bold uppercase tracking-widest text-white/40">Request</p>
							<pre class="max-w-full overflow-x-auto whitespace-pre font-mono text-sm leading-relaxed text-white">{ex.curl}</pre>
						</div>
					</div>
					<div class="p-8 md:p-10 md:w-1/2 bg-black/50">
						<p class="mb-4 text-xs font-bold uppercase tracking-widest text-white/40">Response</p>
						<pre class="font-mono text-xs md:text-sm leading-loose overflow-x-auto" set:html={ex.responseHtml} />
					</div>
				</div>
			))}
		</div>
	</section>

	<script>
		// Animated counters
		function animateCounter(el: Element) {
			const target = el.getAttribute('data-target') || '0'
			const suffix = el.getAttribute('data-suffix') || ''
			const delay = parseInt(el.getAttribute('data-delay') || '0', 10)

			// Parse the target: could be "252", "5,084", "232K"
			const hasK = target.includes('K')
			const numericStr = target.replace(/[,K]/g, '')
			const targetNum = parseInt(numericStr, 10)
			const duration = 1500

			setTimeout(() => {
				const start = performance.now()
				function update(now: number) {
					const elapsed = now - start
					const progress = Math.min(elapsed / duration, 1)
					const eased = 1 - Math.pow(1 - progress, 3)
					const current = Math.round(targetNum * eased)

					if (hasK) {
						el.textContent = `${current.toLocaleString('en-US')}K${suffix}`
					} else {
						el.textContent = `${current.toLocaleString('en-US')}${suffix}`
					}

					if (progress < 1) {
						requestAnimationFrame(update)
					}
				}
				requestAnimationFrame(update)
			}, delay + 200)
		}

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					animateCounter(entry.target)
					observer.unobserve(entry.target)
				}
			})
		}, { threshold: 0.5 })

		document.querySelectorAll('.stat-counter').forEach((el) => observer.observe(el))
	</script>
</Layout>
