---
import Layout from '../layouts/Layout.astro'
import { CodeSample } from '../components/code-sample'
import { PlaceSearch } from '../components/place-search'
import { WorldDots } from '../components/world-dots'
import { SITE_API_URL } from '../lib/api-url'

const apiUrl = SITE_API_URL
const apiHost = apiUrl.replace(/^https?:\/\//, '')

const trust = ['Free to use', 'No API key', 'Open source', 'Updated daily']

const uses = [
	{
		n: '01',
		t: 'Address and sign-up forms',
		d: 'Country, state and city pickers that stay in sync, with postal code formats and phone prefixes for validation.',
		uses: 'Countries · States · Cities'
	},
	{
		n: '02',
		t: 'Localisation',
		d: 'Set the right currency, timezone, clock format and first day of the week for every visitor automatically.',
		uses: 'IP lookup · Currencies · Timezones'
	},
	{
		n: '03',
		t: 'Travel and logistics',
		d: 'Airports with IATA codes, seaports and border crossings, each with coordinates and country.',
		uses: 'Airports · Ports · Airlines'
	},
	{
		n: '04',
		t: 'Research and dashboards',
		d: 'Population, age, income, life expectancy and migration for every country, ready to chart.',
		uses: 'Statistics · Migration'
	}
]

const ledger = [
	{
		label: 'Countries',
		count: '252',
		desc: 'Names, ISO codes, capitals, flags, calling codes and languages.',
		href: '/explore'
	},
	{
		label: 'States and provinces',
		count: '5,056',
		desc: 'Every first-level region with ISO 3166-2 codes.',
		href: '/explore?dataset=states'
	},
	{
		label: 'Cities',
		count: '235,669',
		desc: 'Coordinates, population and timezone for each.',
		href: '/explore?dataset=cities'
	},
	{
		label: 'Airports',
		count: '23,574',
		desc: 'IATA codes, elevation and location.',
		href: '/explore?dataset=airports'
	},
	{
		label: 'Ports',
		count: '17,500',
		desc: 'Seaports and river ports with UN/LOCODE codes.',
		href: '/explore?dataset=ports'
	},
	{
		label: 'Border crossings',
		count: '484',
		desc: 'Official land crossing points.',
		href: '/explore?dataset=border-crossings'
	},
	{
		label: 'Airlines',
		count: '377',
		desc: 'IATA member airlines with designators.',
		href: '/docs#airlines'
	},
	{
		label: 'Timezones',
		count: '312',
		desc: 'UTC offsets and daylight saving rules.',
		href: '/explore?dataset=timezones'
	},
	{
		label: 'Currencies',
		count: '178',
		desc: 'Symbols, decimals and where each is used.',
		href: '/explore?dataset=currencies'
	},
	{
		label: 'Languages',
		count: '7,927',
		desc: 'Every living and historic language code.',
		href: '/docs#languages'
	}
]

const signals = [
	{
		tag: 'Japan',
		big: '30%',
		text: 'of Japanese residents are 65 or older, the second-highest share in the world after Monaco.',
		src: 'Source: World Bank, 2025'
	},
	{
		tag: 'Qatar',
		big: '91.6%',
		text: 'of people living in Qatar were born in another country.',
		src: 'Source: UN DESA, 2024'
	},
	{
		tag: 'Central African Republic',
		big: '48.7%',
		text: 'of the population is under 15, the youngest country in the world.',
		src: 'Source: World Bank, 2025'
	}
]

const faq = [
	{
		q: 'Is Geocoded really free?',
		a: 'Yes. The API is free to use, with no sign-up and no API key. The source code is open under the MIT licence.'
	},
	{
		q: 'Can I use it in a commercial product?',
		a: 'Yes. The data is published under CC BY 4.0, which allows commercial use. Credit Geocoded and its sources when you redistribute the data.'
	},
	{
		q: 'Where does the data come from?',
		a: 'GeoNames, the World Bank, UN DESA, UN/LOCODE, IATA, IANA, ISO and Unicode CLDR. Every dataset lists its source and year.'
	},
	{
		q: 'How current is it?',
		a: 'Datasets are refreshed from their sources and republished daily.'
	},
	{
		q: 'How fast is it?',
		a: 'Responses are served and cached at the edge, close to your users, so repeat requests return almost instantly.'
	}
]

const mapCities = [
	[888, 154],
	[715, 177],
	[837, 169],
	[370, 348],
	[225, 207],
	[587, 173],
	[509, 250],
	[294, 138],
	[500, 103],
	[797, 291],
	[604, 89],
	[578, 356]
]

const mapLabels = [
	{ x: 900, y: 150, t: 'Tokyo' },
	{ x: 238, y: 224, t: 'Mexico City' },
	{ x: 382, y: 365, t: 'São Paulo' },
	{ x: 306, y: 134, t: 'New York' },
	{ x: 521, y: 266, t: 'Lagos' },
	{ x: 727, y: 193, t: 'Delhi' }
]

const wrap = 'mx-auto w-full max-w-[1440px] px-4 md:px-8 lg:px-12'
---

<Layout
	title="Geocoded | Free location data for every country, state and city"
	description="Clean, consistent data for 252 countries, 5,056 states and provinces and 235,669 cities, plus airports, ports, timezones, currencies and population statistics. No sign-up. No API key."
>
	<section class={`${wrap} flex flex-col gap-10 pt-9 pb-7 lg:flex-row lg:items-center lg:gap-16 lg:pt-24 lg:pb-[72px]`}>
		<div class="flex grow flex-col gap-[18px] lg:gap-7">
			<div class="eyebrow flex items-center gap-2.5">
				<span class="size-2 rounded-full bg-signal"></span>Free location data API
			</div>
			<h1 class="serif m-0 max-w-[780px] text-5xl leading-[0.98] tracking-[-0.01em] md:text-7xl lg:text-[92px] lg:leading-[0.96] lg:tracking-[-0.02em]">
				Location data for every country, state and <em class="text-signal">city</em>.
			</h1>
			<p class="m-0 max-w-[620px] text-[17px] leading-normal text-ink-soft lg:text-xl lg:leading-[1.55]">
				Clean, consistent data for 252 countries, 5,056 states and provinces and 235,669 cities, plus airports, ports, timezones, currencies and population statistics. No sign-up. No API key. Just JSON.
			</p>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
				<a href="/docs" class="btn btn-primary h-[52px] px-[26px] text-base">Get started</a>
				<a href="/explore" class="btn btn-outline h-[52px] px-6 text-base">Explore the data</a>
			</div>
			<ul class="m-0 mt-2 flex list-none flex-wrap gap-x-6 gap-y-2 p-0 text-sm text-ink-soft">
				{
					trust.map((t) => (
						<li class="flex items-center gap-2">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#1D4E89" stroke-width="2" aria-hidden="true">
								<path d="M3 8.5l3 3 7-7" />
							</svg>
							{t}
						</li>
					))
				}
			</ul>
		</div>
		<div class="flex w-full shrink-0 flex-col gap-3.5 lg:w-[540px]">
			<div class="overflow-hidden rounded-xl bg-ink text-code lg:rounded-[14px]">
				<div class="flex items-center justify-between border-b border-code-rule px-3.5 py-3 font-mono text-xs lg:px-5 lg:py-3.5 lg:text-[13px]">
					<span class="truncate"><span class="tok-ok">GET</span> {apiHost}/v2/</span>
					<span class="hidden text-[#8A8F99] sm:inline">200 OK</span>
				</div>
				<pre class="m-0 overflow-x-auto p-3.5 font-mono text-xs leading-[1.65] lg:p-5 lg:text-[13px]">{'{'}
  <span class="tok-k">"ip"</span>: <span class="tok-s">"203.0.113.42"</span>,
  <span class="tok-k">"city"</span>: <span class="tok-s">"Tokyo"</span>,
  <span class="tok-k">"region"</span>: <span class="tok-s">"Tokyo"</span>, <span class="tok-k">"regionCode"</span>: <span class="tok-s">"13"</span>,
  <span class="tok-k">"country"</span>: <span class="tok-s">"JP"</span>, <span class="tok-k">"continent"</span>: <span class="tok-s">"AS"</span>, <span class="tok-k">"isEU"</span>: <span class="tok-n">false</span>,
  <span class="tok-k">"latitude"</span>: <span class="tok-s">"35.68536"</span>, <span class="tok-k">"longitude"</span>: <span class="tok-s">"139.75309"</span>,
  <span class="tok-k">"timezone"</span>: <span class="tok-s">"Asia/Tokyo"</span>,
  <span class="tok-k">"countryInfo"</span>: {'{'} <span class="tok-k">"name"</span>: <span class="tok-s">"Japan"</span>, <span class="tok-k">"currency"</span>: <span class="tok-s">"JPY"</span>, <span class="tok-k">"…"</span> {'}'},
  <span class="tok-k">"stateInfo"</span>: {'{'} <span class="tok-k">"…"</span> {'}'}, <span class="tok-k">"cityInfo"</span>: {'{'} <span class="tok-k">"…"</span> {'}'}
{'}'}</pre>
			</div>
			<p class="m-0 text-sm leading-normal text-ink-soft">
				One request tells you where a visitor is: country, region, city, timezone and currency. Use it to prefill forms, pick a default currency or show local time.
			</p>
		</div>
	</section>

	<div class={wrap}>
		<section class="flex flex-col gap-8 border-y border-rule py-10 lg:flex-row lg:items-center lg:gap-11 lg:py-14">
			<div class="flex shrink-0 flex-col gap-[18px] lg:w-[300px]">
				<h2 class="serif m-0 text-4xl leading-none lg:text-5xl">Coverage that goes all the way down.</h2>
				<p class="m-0 text-base leading-[1.55] text-ink-soft">
					From capitals to small towns. Every point on this map is a city in Geocoded, plotted from its real coordinates.
				</p>
				<dl class="mt-2 flex flex-col gap-2.5 text-[15px]">
					<div class="flex justify-between border-b border-rule pb-2.5">
						<dt>Countries and territories</dt><dd class="font-mono font-medium">252</dd>
					</div>
					<div class="flex justify-between border-b border-rule pb-2.5">
						<dt>States and provinces</dt><dd class="font-mono font-medium">5,056</dd>
					</div>
					<div class="flex justify-between">
						<dt>Cities and towns</dt><dd class="font-mono font-medium">235,669</dd>
					</div>
				</dl>
			</div>
			<div class="min-w-0 grow">
				<WorldDots dot="#6B6F78" label="World map drawn from the locations of 235,669 cities">
					<g fill="#C2410C" stroke="#F3F1EA" stroke-width="2">
						{mapCities.map(([cx, cy]) => <circle cx={cx} cy={cy} r="7" />)}
					</g>
					<g
						font-family="IBM Plex Sans, sans-serif"
						font-size="13"
						font-weight="600"
						fill="#14161A"
						stroke="#F3F1EA"
						stroke-width="4"
						stroke-linejoin="round"
						paint-order="stroke"
					>
						{mapLabels.map((l) => <text x={l.x} y={l.y}>{l.t}</text>)}
					</g>
				</WorldDots>
			</div>
		</section>
	</div>

	<section class={`${wrap} flex flex-col gap-10 pt-16 pb-10 lg:pt-24`}>
		<div class="flex max-w-[760px] flex-col gap-3.5">
			<span class="eyebrow">Use cases</span>
			<h2 class="serif m-0 text-4xl leading-none lg:text-6xl">Built for the location features every product needs.</h2>
		</div>
		<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
			{
				uses.map((u) => (
					<article class="card flex flex-col gap-3.5 rounded-[14px] p-5 lg:p-7">
						<span class="font-mono text-[13px] text-signal">{u.n}</span>
						<h3 class="m-0 text-lg leading-tight font-semibold lg:text-[21px]">{u.t}</h3>
						<p class="m-0 text-[15px] leading-[1.55] text-ink-soft">{u.d}</p>
						<div class="grow" />
						<span class="border-t border-rule-soft pt-3.5 text-[13px]">{u.uses}</span>
					</article>
				))
			}
		</div>
	</section>

	<section class={`${wrap} flex flex-col gap-8 pt-12 pb-10 lg:pt-[72px]`}>
		<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div class="flex flex-col gap-3.5">
				<span class="eyebrow">What's included</span>
				<h2 class="serif m-0 text-4xl leading-none lg:text-6xl">Ten datasets, one consistent API.</h2>
			</div>
			<a href="/docs" class="text-link text-[15px]">Browse the API reference →</a>
		</div>
		<div class="grid grid-cols-2 border-t-2 border-ink md:grid-cols-3 lg:grid-cols-5">
			{
				ledger.map((r) => (
					<a href={r.href} class="group flex flex-col gap-2.5 border-b border-rule py-6 pr-4 lg:pr-6">
						<span class="text-base font-semibold group-hover:text-signal">{r.label}</span>
						<span class="serif text-4xl leading-none lg:text-5xl">{r.count}</span>
						<span class="text-sm leading-normal text-ink-soft">{r.desc}</span>
					</a>
				))
			}
		</div>
	</section>

	<section class={`${wrap} flex flex-col gap-10 py-12 lg:flex-row lg:items-center lg:gap-14 lg:py-[72px]`}>
		<div class="flex shrink-0 flex-col gap-5 lg:w-[440px]">
			<span class="eyebrow">For developers</span>
			<h2 class="serif m-0 text-4xl leading-none lg:text-[56px]">Ask for exactly what you need.</h2>
			<p class="m-0 text-[17px] leading-[1.55] text-ink-soft">
				Filter by country or state, sort by any field and return only the fields you use. Every list comes back paginated in the same shape, so your code stays simple.
			</p>
			<ul class="m-0 flex list-none flex-col gap-3 p-0 text-base">
				<li class="flex gap-3"><span class="text-signal" aria-hidden="true">—</span>Look up places by name or ISO code</li>
				<li class="flex gap-3"><span class="text-signal" aria-hidden="true">—</span>Nested routes: country, state, city</li>
				<li class="flex gap-3"><span class="text-signal" aria-hidden="true">—</span>Cached at the edge for fast responses worldwide</li>
				<li class="flex gap-3"><span class="text-signal" aria-hidden="true">—</span>OpenAPI 3.1 spec and a TypeScript client</li>
			</ul>
		</div>
		<CodeSample client:visible apiUrl={apiUrl} />
	</section>

	<div class={wrap}>
		<section class="flex flex-col gap-8 rounded-[18px] bg-ink p-6 text-paper md:p-10 lg:flex-row lg:items-center lg:gap-14 lg:p-16">
			<div class="flex grow flex-col gap-4">
				<h2 class="serif m-0 text-4xl leading-none lg:text-6xl">Instant search for any place.</h2>
				<p class="m-0 max-w-[480px] text-[17px] leading-[1.55] text-code-muted">
					Type a name and get matching countries, states and cities in one request. Ideal for location autocomplete.
				</p>
			</div>
			<div class="w-full shrink-0 lg:w-[620px]">
				<PlaceSearch client:visible variant="hero" initialQuery="tokyo" placeholder="Try a city, state or country" />
			</div>
		</section>
	</div>

	<section class={`${wrap} flex flex-col gap-8 pt-16 pb-10 lg:pt-24`}>
		<div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div class="flex flex-col gap-3.5">
				<span class="eyebrow">The world in numbers</span>
				<h2 class="serif m-0 text-4xl leading-none lg:text-6xl">More than places: the people in them.</h2>
			</div>
			<a href="/insights" class="text-link text-[15px]">See all insights →</a>
		</div>
		<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
			{
				signals.map((s) => (
					<article class="card flex flex-col gap-3.5 rounded-[14px] p-6 lg:p-[30px]">
						<span class="text-[15px] font-semibold">{s.tag}</span>
						<span class="serif text-6xl leading-[0.9] text-signal lg:text-[84px]">{s.big}</span>
						<p class="m-0 text-[17px] leading-normal">{s.text}</p>
						<div class="grow" />
						<span class="border-t border-rule-soft pt-3.5 text-[13px] text-ink-soft">{s.src}</span>
					</article>
				))
			}
		</div>
	</section>

	<section class={`${wrap} flex flex-col gap-8 py-12 lg:flex-row lg:gap-16 lg:py-[72px]`}>
		<div class="flex shrink-0 flex-col gap-4 lg:w-[440px]">
			<span class="eyebrow">Questions</span>
			<h2 class="serif m-0 text-4xl leading-none lg:text-[56px]">Frequently asked.</h2>
		</div>
		<div class="flex grow flex-col border-t border-ink">
			{
				faq.map((f) => (
					<details class="border-b border-rule py-[22px]">
						<summary class="text-[17px] font-semibold lg:text-[19px]">{f.q}</summary>
						<p class="m-0 mt-3 max-w-[760px] text-base leading-relaxed text-ink-soft">{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<div class={`${wrap} mb-[72px]`}>
		<section class="flex flex-col gap-6 rounded-[18px] border border-ink p-6 md:flex-row md:items-center md:gap-10 md:p-10 lg:px-16 lg:py-14">
			<h2 class="serif m-0 grow text-4xl leading-none lg:text-[52px]">Make your first request in under a minute.</h2>
			<a href="/docs#quick-start" class="btn btn-primary h-[52px] px-[26px] text-base">Read the quick start</a>
		</section>
	</div>
</Layout>
