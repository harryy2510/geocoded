---
import Layout from '../layouts/Layout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.geocoded.me'
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL || 'https://github.com/geocoded-me/geocoded'

const features = [
	{
		title: 'Free & Open Source',
		description: 'No API key, no signup, no rate limits. Data sourced from official institutions (GeoNames, CLDR, Wikidata, IANA) under CC BY 4.0.',
		number: '01'
	},
	{
		title: 'Global Edge Network',
		description: 'Powered by Cloudflare Workers with near-zero cold starts. Cached at the edge for millisecond responses from the closest POP.',
		number: '02'
	},
	{
		title: 'Rich Data',
		description: '252 countries, 3,800+ states, and 230,000+ cities with translations, coordinates, phone codes, timezones and currencies.',
		number: '03'
	},
	{
		title: 'Field Selection',
		description: 'Pick exactly the fields you need with ?fields= parameter. Supports dot notation for nested objects. Smaller payloads, faster apps.',
		number: '04'
	},
]

const dataPages = [
	{
		href: '/dashboard',
		title: 'Dashboard',
		description: 'Global data overview with interactive charts and key metrics across all 252 countries.',
	},
	{
		href: '/explorer',
		title: 'Explorer',
		description: 'Browse and filter countries, states, and cities with an interactive world map.',
	},
	{
		href: '/statistics',
		title: 'Statistics',
		description: 'Dive into population, area, GDP, literacy, and other comparative statistics.',
	},
	{
		href: '/quiz',
		title: 'Quiz',
		description: 'Test your geography knowledge with fun quizzes on flags, capitals, and more.',
	},
]

function jsonKv(k: string, v: string, last = false) {
	return `  <span class="text-white">"${k}"</span><span class="text-white/50">: </span><span class="text-white/80">"${v}"</span>${last ? '' : ','}\n`
}
function jsonKvNum(k: string, v: string, last = false) {
	return `  <span class="text-white">"${k}"</span><span class="text-white/50">: </span><span class="text-white/80">${v}</span>${last ? '' : ','}\n`
}
function jsonKvi(k: string, v: string, last = false) {
	return `    <span class="text-white">"${k}"</span><span class="text-white/50">: </span><span class="text-white/80">"${v}"</span>${last ? '' : ','}\n`
}
function jsonKviNum(k: string, v: string, last = false) {
	return `    <span class="text-white">"${k}"</span><span class="text-white/50">: </span><span class="text-white/80">${v}</span>${last ? '' : ','}\n`
}
function jsonKviRaw(k: string, v: string, last = false) {
	return `    <span class="text-white">"${k}"</span><span class="text-white/50">: </span>${v}${last ? '' : ','}\n`
}
function jsonBr(v: string) {
	return `<span class="text-white/50">${v}</span>\n`
}

const examples = [
	{
		title: 'Your location from IP',
		curl: `curl ${apiUrl}`,
		responseHtml:
			jsonBr('{') +
			jsonKv('ip', '203.0.113.42') +
			jsonKv('country', 'US') +
			jsonKv('region', 'California') +
			jsonKv('city', 'San Francisco') +
			jsonKvNum('latitude', '37.7749') +
			jsonKvNum('longitude', '-122.4194') +
			jsonKv('timezone', 'America/Los_Angeles', true) +
			jsonBr('}'),
	},
	{
		title: 'Countries with field selection',
		curl: `curl ${apiUrl}/countries/US?fields=name,iso2,capital,currency`,
		responseHtml:
			jsonBr('{') +
			jsonKv('name', 'United States') +
			jsonKv('iso2', 'US') +
			jsonKv('capital', 'Washington') +
			jsonKv('currency', 'USD', true) +
			jsonBr('}'),
	},
	{
		title: 'Drill down to states and cities',
		curl: `curl ${apiUrl}/countries/US/states/CA/cities?fields=name,latitude,longitude`,
		responseHtml:
			jsonBr('[') +
			jsonBr('  {') +
			jsonKvi('name', 'Los Angeles') +
			jsonKviNum('latitude', '34.05223420') +
			jsonKviNum('longitude', '-118.24368490', true) +
			jsonBr('  },') +
			jsonBr('  {') +
			jsonKvi('name', 'San Francisco') +
			jsonKviNum('latitude', '37.77492950') +
			jsonKviNum('longitude', '-122.41941550', true) +
			jsonBr('  }') +
			jsonBr(']'),
	},
	{
		title: 'Search across all entities',
		curl: `curl ${apiUrl}/search?q=tokyo`,
		responseHtml:
			jsonBr('{') +
			`  <span class="text-white">"data"</span><span class="text-white/50">: </span>[\n` +
			jsonBr('    {') +
			jsonKvi('type', 'state') +
			jsonKvi('name', 'Tokyo') +
			jsonKvi('countryCode', 'JP') +
			jsonKvi('countryName', 'Japan') +
			jsonKviRaw('geonameId', '<span class="text-white/80">null</span>') +
			jsonKvi('stateCode', '13') +
			jsonKviRaw('stateName', '<span class="text-white/80">null</span>', true) +
			jsonBr('    },') +
			jsonBr('    {') +
			jsonKvi('type', 'city') +
			jsonKvi('name', 'Tokyo') +
			jsonKvi('countryCode', 'JP') +
			jsonKvi('countryName', 'Japan') +
			jsonKviNum('geonameId', '1850147') +
			jsonKvi('stateCode', '13') +
			jsonKvi('stateName', 'Tokyo', true) +
			jsonBr('    },') +
			jsonBr('    {') +
			jsonKvi('type', 'city') +
			jsonKvi('name', 'Nishi-Tokyo-shi') +
			jsonKvi('countryCode', 'JP') +
			jsonKvi('countryName', 'Japan') +
			jsonKviNum('geonameId', '1850692') +
			jsonKvi('stateCode', '13') +
			jsonKvi('stateName', 'Tokyo', true) +
			jsonBr('    }') +
			`  <span class="text-white/50">],</span>\n` +
			`  <span class="text-white">"meta"</span><span class="text-white/50">: </span><span class="text-white/80">{ ... }</span>\n` +
			jsonBr('}'),
	},
	{
		title: 'List timezones',
		curl: `curl ${apiUrl}/timezones?limit=2&fields=timezone,name,standardOffsetName,observesDst`,
		responseHtml:
			jsonBr('{') +
			`  <span class="text-white">"data"</span><span class="text-white/50">: </span>[\n` +
			jsonBr('    {') +
			jsonKvi('timezone', 'America/New_York') +
			jsonKvi('name', 'Eastern Time') +
			jsonKvi('standardOffsetName', 'UTC-05:00') +
			jsonKviRaw('observesDst', '<span class="text-white/80">true</span>', true) +
			jsonBr('    },') +
			jsonBr('    {') +
			jsonKvi('timezone', 'Europe/London') +
			jsonKvi('name', 'United Kingdom Time') +
			jsonKvi('standardOffsetName', 'UTC+00:00') +
			jsonKviRaw('observesDst', '<span class="text-white/80">true</span>', true) +
			jsonBr('    }') +
			`  <span class="text-white/50">],</span>\n` +
			`  <span class="text-white">"meta"</span><span class="text-white/50">: </span><span class="text-white/80">{ ... }</span>\n` +
			jsonBr('}'),
	},
	{
		title: 'List currencies',
		curl: `curl ${apiUrl}/currencies?limit=2&fields=code,name,symbol,countries`,
		responseHtml:
			jsonBr('{') +
			`  <span class="text-white">"data"</span><span class="text-white/50">: </span>[\n` +
			jsonBr('    {') +
			jsonKvi('code', 'USD') +
			jsonKvi('name', 'US Dollar') +
			jsonKvi('symbol', '$') +
			jsonKviRaw('countries', '<span class="text-white/80">["US"]</span>', true) +
			jsonBr('    },') +
			jsonBr('    {') +
			jsonKvi('code', 'EUR') +
			jsonKvi('name', 'Euro') +
			jsonKvi('symbol', '€') +
			jsonKviRaw('countries', '<span class="text-white/80">["AD","AT","BE"]</span>', true) +
			jsonBr('    }') +
			`  <span class="text-white/50">],</span>\n` +
			`  <span class="text-white">"meta"</span><span class="text-white/50">: </span><span class="text-white/80">{ ... }</span>\n` +
			jsonBr('}'),
	},
]

const stats = [
	{ label: 'Countries', value: '252', suffix: '' },
	{ label: 'States', value: '5,084', suffix: '+' },
	{ label: 'Cities', value: '232K', suffix: '+' },
	{ label: 'Timezones', value: '312', suffix: '' },
]
---

<Layout title="Geocoded | Free Country, State, City & Location API" description="Free, fast REST API for country, state, city, and IP geolocation data. Powered by Cloudflare Workers with global edge caching.">
	<!-- Hero -->
	<div class="min-h-[70vh] flex flex-col justify-center items-start border-l border-white/20 pl-10 md:pl-20 mb-32 pt-20">
		<p class="text-lg font-bold tracking-widest text-white/40 uppercase mb-6 w-full">
			Free Country, State, City & Location API
		</p>
		<h1 class="text-6xl md:text-8xl lg:text-[10rem] font-bold tracking-tighter leading-[0.85] uppercase mb-8">
			Geocoded
		</h1>
		<p class="text-xl md:text-2xl font-light text-white/60 max-w-2xl leading-relaxed mb-16">
			Open-source REST API with 252 countries, 3,800+ states, and 230,000+ cities.
			No API key required. Deployed on the edge for instant responses worldwide.
		</p>

		<div class="flex flex-wrap gap-6">
			<a href="/docs" class="bg-white text-black px-10 py-5 rounded-none font-bold tracking-widest uppercase text-sm hover:bg-white/80 transition-colors">
				View API Docs
			</a>
			<a href={githubUrl} target="_blank" class="lux-panel px-10 py-5 rounded-none font-bold tracking-widest uppercase text-sm hover:bg-white/10 transition-colors flex items-center gap-3">
				<svg class="size-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
				GitHub
			</a>
		</div>
	</div>

	<!-- Stats Banner -->
	<div class="mb-32">
		<div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-white/20 border border-white/20">
			{stats.map((stat, i) => (
				<div class="bg-black p-8 md:p-12 relative overflow-hidden group">
					<div class="absolute inset-0 bg-white/[0.02] opacity-0 group-hover:opacity-100 transition-opacity"></div>
					<div class="text-sm font-bold text-white/40 tracking-widest uppercase mb-4">{stat.label}</div>
					<div class="stat-counter text-4xl md:text-6xl font-bold tracking-tighter" data-target={stat.value} data-suffix={stat.suffix} data-delay={i * 100}>
						{stat.value}{stat.suffix}
					</div>
				</div>
			))}
		</div>
	</div>

	<!-- Features Matrix -->
	<section class="mb-32 pt-12 border-t border-white/20">
		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-white/40">Why Geocoded</p>
		<h2 class="mb-6 text-4xl md:text-6xl font-bold tracking-tighter uppercase">Built for developers<br/><span class="text-white/40">who ship fast</span></h2>
		<p class="mb-16 max-w-lg text-lg text-white/60 leading-relaxed">
			No signup, no API key, no rate limits. Just clean JSON over HTTPS.
		</p>

		<div class="grid md:grid-cols-2 gap-px bg-white/20 border border-white/20">
			{features.map((f) => (
				<div class="bg-black p-12 lg:p-16 flex flex-col justify-between min-h-[350px] group hover:bg-white/[0.02] transition-colors">
					<div>
						<h3 class="text-3xl font-bold tracking-tighter uppercase mb-4">{f.title}</h3>
						<p class="text-white/60 text-lg leading-relaxed">{f.description}</p>
					</div>
					<div class="text-6xl font-bold text-white/20 uppercase tracking-tighter mt-12 group-hover:text-white/40 transition-colors">{f.number}</div>
				</div>
			))}
		</div>
	</section>

	<!-- See the Data CTA -->
	<section class="mb-32 pt-12 border-t border-white/20">
		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-white/40">See the Data</p>
		<h2 class="mb-6 text-4xl md:text-6xl font-bold tracking-tighter uppercase">Explore the<br/><span class="text-white/40">full dataset</span></h2>
		<p class="mb-16 max-w-lg text-lg text-white/60 leading-relaxed">
			Interactive tools to browse, visualize, and analyze geography data from the API.
		</p>

		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/20 border border-white/20">
			{dataPages.map((page) => (
				<a href={page.href} class="bg-black p-8 md:p-12 min-h-[300px] flex flex-col justify-between group hover:bg-white/[0.02] transition-colors cursor-pointer">
					<div>
						<h3 class="text-2xl font-bold tracking-tighter uppercase mb-4">{page.title}</h3>
						<p class="text-white/60 text-base leading-relaxed">{page.description}</p>
					</div>
					<div class="mt-8 font-bold tracking-widest uppercase text-xs text-white/40 group-hover:text-white transition-colors flex items-center gap-2">
						[ Launch ]
						<svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
					</div>
				</a>
			))}
		</div>
	</section>

	<!-- Quick Start Examples -->
	<section class="mb-32 pt-12 border-t border-white/20" id="examples">
		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-white/40">Quick Start</p>
		<h2 class="mb-6 text-4xl md:text-6xl font-bold tracking-tighter uppercase">Simple endpoints<br/><span class="text-white/40">zero config</span></h2>
		<p class="mb-16 max-w-lg text-lg text-white/60 leading-relaxed">
			Every response is JSON with aggressive cache headers. Try these from your terminal right now.
		</p>

		<div class="flex flex-col gap-8">
			{examples.map((ex) => (
				<div class="lux-panel p-0 overflow-hidden flex flex-col md:flex-row">
					<div class="p-8 md:p-10 border-b md:border-b-0 md:border-r border-white/20 md:w-1/2 flex flex-col justify-between">
						<div>
							<div class="flex items-center justify-between mb-8">
								<h3 class="text-xl font-bold tracking-tighter uppercase text-white/80">{ex.title}</h3>
								<span class="rounded-none bg-white text-black px-2 py-1 text-[10px] font-bold tracking-widest uppercase">GET</span>
							</div>
							<p class="mb-4 text-xs font-bold uppercase tracking-widest text-white/40">Request</p>
							<div class="flex flex-wrap items-center gap-3">
								<span class="text-white/50 font-mono">~</span>
								<span class="text-white font-mono text-sm break-all">{ex.curl}</span>
							</div>
						</div>
					</div>
					<div class="p-8 md:p-10 md:w-1/2 bg-black/50">
						<p class="mb-4 text-xs font-bold uppercase tracking-widest text-white/40">Response</p>
						<pre class="font-mono text-xs md:text-sm leading-loose overflow-x-auto" set:html={ex.responseHtml} />
					</div>
				</div>
			))}
		</div>
	</section>

	<script>
		// Animated counters
		function animateCounter(el: Element) {
			const target = el.getAttribute('data-target') || '0'
			const suffix = el.getAttribute('data-suffix') || ''
			const delay = parseInt(el.getAttribute('data-delay') || '0', 10)

			// Parse the target: could be "252", "5,084", "232K"
			const hasK = target.includes('K')
			const numericStr = target.replace(/[,K]/g, '')
			const targetNum = parseInt(numericStr, 10)
			const duration = 1500

			setTimeout(() => {
				const start = performance.now()
				function update(now: number) {
					const elapsed = now - start
					const progress = Math.min(elapsed / duration, 1)
					const eased = 1 - Math.pow(1 - progress, 3)
					const current = Math.round(targetNum * eased)

					if (hasK) {
						el.textContent = `${current.toLocaleString('en-US')}K${suffix}`
					} else {
						el.textContent = `${current.toLocaleString('en-US')}${suffix}`
					}

					if (progress < 1) {
						requestAnimationFrame(update)
					}
				}
				requestAnimationFrame(update)
			}, delay + 200)
		}

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					animateCounter(entry.target)
					observer.unobserve(entry.target)
				}
			})
		}, { threshold: 0.5 })

		document.querySelectorAll('.stat-counter').forEach((el) => observer.observe(el))
	</script>
</Layout>
