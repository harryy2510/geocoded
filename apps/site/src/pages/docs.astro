---
import Layout from '../layouts/Layout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.geocoded.me'
const openApiUrl = `${apiUrl}/openapi.json`
const postmanUrl = `${apiUrl}/postman.json`
---

<Layout title="Geocoded API | Documentation">
	<style is:global>
		:root, .dark-mode, .light-mode, .scalar-theme, .scalar-app {
			--scalar-color-1: #ffffff !important;
			--scalar-color-2: #cccccc !important;
			--scalar-color-3: #999999 !important;
			--scalar-color-accent: #ffffff !important;

			--scalar-background-1: #000000 !important;
			--scalar-background-2: #111111 !important;
			--scalar-background-3: #222222 !important;

			--scalar-sidebar-color-1: #ffffff !important;
			--scalar-sidebar-color-2: #cccccc !important;
			--scalar-sidebar-color-active: #ffffff !important;
			--scalar-sidebar-background-1: #000000 !important;

			--scalar-border-color: rgba(255,255,255,0.2) !important;

			--scalar-button-1: #ffffff !important;
			--scalar-button-1-color: #000000 !important;
			--scalar-button-1-hover: #dddddd !important;

			font-family: 'Space Grotesk', system-ui, sans-serif !important;
		}

		.scalar-theme h1, .scalar-theme h2, .scalar-theme h3, .scalar-theme h4, .scalar-theme h5, .scalar-theme h6 {
			font-family: 'Space Grotesk', system-ui, sans-serif !important;
			text-transform: uppercase;
			letter-spacing: -0.02em;
			font-weight: 700;
		}

		.scalar-theme pre, .scalar-theme code {
			font-family: 'Space Mono', monospace !important;
		}

		.scalar-theme .markdown a.geocoded-docs-link {
			text-decoration: none !important;
		}

		.scalar-theme .geocoded-docs-link-primary {
			color: #ffffff;
		}

		.scalar-theme .geocoded-docs-link > span:not(.geocoded-docs-badge) {
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}

		.scalar-theme .tag-section-container > .section:has(.endpoints-card) {
			border-top: 1px solid rgba(255,255,255,0.1);
		}
	</style>

	<div class="animate-fade-in">
		<h1 class="text-5xl md:text-7xl font-bold tracking-tighter uppercase mb-4">API Protocol</h1>
		<p class="text-white/60 text-lg mb-12">Standard operating procedures and endpoint definitions.</p>

		<div class="mb-12 flex flex-wrap gap-4">
			<a href={openApiUrl} target="_blank" class="lux-panel px-6 py-3 font-bold tracking-widest uppercase text-xs hover:bg-white/10 transition-colors inline-block">
				[ Download OpenAPI JSON ]
			</a>
			<a href={postmanUrl} target="_blank" class="lux-panel px-6 py-3 font-bold tracking-widest uppercase text-xs hover:bg-white/10 transition-colors inline-block">
				[ Download Postman Collection ]
			</a>
		</div>

		<div class="border-t border-b border-white/20 -mx-6 px-6 bg-black">
			<div id="scalar-root" data-api-url={apiUrl} class="scalar-theme"></div>
		</div>
	</div>

	<script is:inline src="https://cdn.jsdelivr.net/npm/@scalar/api-reference" onload="window.mountGeocodedDocsReference()"></script>
	<script is:inline>
		window.mountGeocodedDocsReference = () => {
			const root = document.getElementById('scalar-root')
			if (!window.Scalar || !root) return
			const apiUrl = root.dataset.apiUrl || 'https://api.geocoded.me'
			window.Scalar.createApiReference(root, {
				theme: 'none',
				darkMode: true,
				hideDarkModeToggle: true,
				defaultOpenAllTags: true,
				documentDownloadType: 'none',
				sources: [
					{
						title: 'Geocoded v2 (Latest)',
						url: `${apiUrl}/v2/openapi.json`,
					},
					{
						title: 'Geocoded v1',
						url: `${apiUrl}/openapi.json`,
					}
				],
			})
		}

		if (window.Scalar) {
			window.mountGeocodedDocsReference()
		}
	</script>
</Layout>
