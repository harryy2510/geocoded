---
import Layout from '../layouts/Layout.astro'

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://api.geocoded.me'
const docsVersions = [
	{
		id: 'v2',
		label: 'Geocoded v2',
		kicker: 'Latest',
		openApiUrl: `${apiUrl}/v2/openapi.json`,
		postmanUrl: `${apiUrl}/v2/postman.json`
	},
	{
		id: 'v1',
		label: 'Geocoded v1',
		kicker: 'Legacy',
		openApiUrl: `${apiUrl}/openapi.json`,
		postmanUrl: `${apiUrl}/postman.json`
	}
]
const defaultDocsVersion = docsVersions[0]
---

<Layout title="Geocoded API | Documentation">
	<style is:global>
		:root, .dark-mode, .light-mode, .scalar-theme, .scalar-app {
			--scalar-color-1: #ffffff !important;
			--scalar-color-2: #cccccc !important;
			--scalar-color-3: #999999 !important;
			--scalar-color-accent: #ffffff !important;

			--scalar-background-1: #000000 !important;
			--scalar-background-2: #111111 !important;
			--scalar-background-3: #222222 !important;

			--scalar-sidebar-color-1: #ffffff !important;
			--scalar-sidebar-color-2: #cccccc !important;
			--scalar-sidebar-color-active: #ffffff !important;
			--scalar-sidebar-background-1: #000000 !important;

			--scalar-border-color: rgba(255,255,255,0.2) !important;

			--scalar-button-1: #ffffff !important;
			--scalar-button-1-color: #000000 !important;
			--scalar-button-1-hover: #dddddd !important;

			font-family: 'Space Grotesk', system-ui, sans-serif !important;
		}

		.scalar-theme h1, .scalar-theme h2, .scalar-theme h3, .scalar-theme h4, .scalar-theme h5, .scalar-theme h6 {
			font-family: 'Space Grotesk', system-ui, sans-serif !important;
			text-transform: uppercase;
			letter-spacing: -0.02em;
			font-weight: 700;
		}

		.scalar-theme pre, .scalar-theme code {
			font-family: 'Space Mono', monospace !important;
		}

		.scalar-theme .markdown a.geocoded-docs-link {
			text-decoration: none !important;
		}

		.scalar-theme .geocoded-docs-link-primary {
			color: #ffffff;
		}

		.scalar-theme .geocoded-docs-link > span:not(.geocoded-docs-badge) {
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}

		.scalar-theme .tag-section-container > .section:has(.endpoints-card) {
			border-top: 1px solid rgba(255,255,255,0.1);
		}

		.docs-reference-frame {
			border: 1px solid rgba(255,255,255,0.14);
			position: sticky;
			top: 0;
			z-index: 30;
		}

		body:has([data-docs-root]) nav {
			z-index: 20;
		}

		body:has([data-docs-root]) > .scalar-app [role="dialog"],
		body:has([data-docs-root]) > .scalar-app [aria-modal="true"],
		body:has([data-docs-root]) > .scalar-app [class*="modal"],
		body:has([data-docs-root]) > .scalar-app [class*="dialog"] {
			z-index: 100 !important;
		}
	</style>

	<div
		class="animate-fade-in"
		data-docs-root
		data-docs-versions={JSON.stringify(docsVersions)}
	>
		<div class="mb-12 flex flex-col gap-8 xl:flex-row xl:items-end xl:justify-between">
			<div>
				<h1 class="text-5xl md:text-7xl font-bold tracking-tighter uppercase mb-4">API Protocol</h1>
				<p class="text-white/60 text-lg">Standard operating procedures and endpoint definitions.</p>
			</div>

			<div class="w-full xl:w-auto">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-stretch xl:justify-end">
					<label class="lux-panel flex min-h-14 min-w-64 items-center justify-between gap-5 px-5 py-3">
						<span class="text-[10px] font-bold uppercase tracking-widest text-white/40">Version</span>
						<select
							id="docs-version"
							data-docs-version
							class="min-w-40 cursor-pointer bg-transparent text-right text-base font-bold uppercase tracking-tight text-white outline-none focus-visible:ring-2 focus-visible:ring-white/60"
							aria-label="API version"
						>
							{docsVersions.map((version) => (
								<option value={version.id} selected={version.id === defaultDocsVersion.id}>
									{version.label} ({version.kicker})
								</option>
							))}
						</select>
					</label>

					<div class="flex flex-col gap-3 sm:flex-row sm:items-stretch xl:justify-end">
						<a
							href={defaultDocsVersion.openApiUrl}
							target="_blank"
							data-openapi-download
							class="lux-panel inline-flex min-h-14 items-center justify-center px-6 py-3 text-center text-xs font-bold uppercase tracking-widest transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
						>
							[ Download OpenAPI JSON ]
						</a>
						<a
							href={defaultDocsVersion.postmanUrl}
							target="_blank"
							data-postman-download
							class="lux-panel inline-flex min-h-14 items-center justify-center px-6 py-3 text-center text-xs font-bold uppercase tracking-widest transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
						>
							[ Download Postman Collection ]
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="docs-reference-frame">
			<div id="scalar-root" class="scalar-theme min-h-[900px]"></div>
		</div>
	</div>

	<script is:inline>
		(() => {
			const shell = document.querySelector('[data-docs-root]')
			const root = document.getElementById('scalar-root')
			const versionSelect = document.querySelector('[data-docs-version]')
			const openApiLink = document.querySelector('[data-openapi-download]')
			const postmanLink = document.querySelector('[data-postman-download]')
			const versions = JSON.parse(shell?.dataset.docsVersions || '[]')
			let activeVersionId = versionSelect?.value || versions[0]?.id

			function activeVersion() {
				return versions.find((version) => version.id === activeVersionId) || versions[0]
			}

			function updateLinks(version) {
				if (openApiLink) openApiLink.href = version.openApiUrl
				if (postmanLink) postmanLink.href = version.postmanUrl
			}

			window.mountGeocodedDocsReference = () => {
				const version = activeVersion()
				if (!version) return
				updateLinks(version)
				if (!window.Scalar || !root) return
				root.replaceChildren()
				window.Scalar.createApiReference(root, {
					theme: 'none',
					darkMode: true,
					hideDarkModeToggle: true,
					defaultOpenAllTags: true,
					documentDownloadType: 'none',
					agent: { disabled: true },
					url: version.openApiUrl,
				})
			}

			versionSelect?.addEventListener('change', () => {
				activeVersionId = versionSelect.value
				window.history.replaceState(null, '', window.location.pathname)
				window.mountGeocodedDocsReference()
			})

			if (window.Scalar) {
				window.mountGeocodedDocsReference()
			}
		})()
	</script>
	<script is:inline src="https://cdn.jsdelivr.net/npm/@scalar/api-reference" onload="window.mountGeocodedDocsReference?.()"></script>
</Layout>
