---
import '../styles/global.css'

const { title = 'GEOCODED | Premium Data Layer', description = 'Premium geographic data layer.' } = Astro.props

const siteUrl = 'https://geocoded.me'
const ogImage = `${siteUrl}/og-image.png`
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#000000" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-black text-white antialiased min-h-screen flex flex-col">
		<div class="noise"></div>

		<nav class="sticky top-0 w-full z-50 border-b border-white/10 bg-black/50 backdrop-blur-xl">
			<div class="max-w-[1600px] mx-auto px-6 py-5 flex justify-between items-center">
				<a href="/" class="font-bold text-xl tracking-tighter uppercase flex items-center gap-4 hover:opacity-70 transition-opacity">
					<img src="/favicon.svg" alt="Geocoded Logo" class="w-8 h-8" />
					GEOCODED
				</a>

				<div class="hidden md:flex gap-10 text-xs font-semibold tracking-widest uppercase">
					<a href="/explorer" class="hover:text-white/50 transition-colors">Explorer</a>
					<a href="/dashboard" class="hover:text-white/50 transition-colors">Dashboard</a>
					<a href="/statistics" class="hover:text-white/50 transition-colors">Stats</a>
					<a href="/quiz" class="hover:text-white/50 transition-colors">Quiz</a>
					<a href="/docs" class="hover:text-white/50 transition-colors">API Docs</a>
				</div>
			</div>
		</nav>

		<main class="flex-1 w-full max-w-[1600px] mx-auto px-6 pt-32 pb-24 relative">
			<slot />
		</main>

		<footer class="border-t border-white/10 py-12 text-center text-xs tracking-widest uppercase font-medium text-white/40">
			<div class="max-w-[1600px] mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
				<div>GEOCODED © 2026</div>
				<div class="flex gap-6">
					<a href="https://github.com/harryy2510/geocoded" class="hover:text-white transition-colors">GitHub</a>
					<a href="/docs" class="hover:text-white transition-colors">Documentation</a>
				</div>
			</div>
		</footer>
	</body>
</html>
