{
	"name": "geocoded",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @geocoded/api dev",
		"dev:site": "bun run --filter @geocoded/site dev",
		"build:site": "bun run --filter @geocoded/site build",
		"preview:site": "bun run --filter @geocoded/site preview",
		"deploy": "bun run --filter @geocoded/api deploy",
		"seed": "bun run --filter @geocoded/api seed",
		"seed:upload": "bun run --filter @geocoded/api seed:upload",
		"types": "bun run --filter @geocoded/api types",
		"test": "bun test",
		"check": "bun lint:check && bun format:check",
		"fix": "bun lint:fix && bun format:fix",
		"lint:check": "oxlint --type-aware --type-check --max-warnings 0",
		"lint:fix": "oxlint --type-aware --type-check --fix",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.62.0",
		"oxlint-tsgolint": "^0.22.0",
		"wrangler": "^4.86.0"
	}
}
