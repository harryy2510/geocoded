{
	"name": "geocoded",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @geocoded/site dev",
		"dev:api": "bun run --filter @geocoded/api dev",
		"build:site": "bun run --filter @geocoded/site build",
		"preview:site": "bun run --filter @geocoded/site preview",
		"deploy": "bun run --filter @geocoded/api deploy",
		"seed": "bun run --filter @geocoded/api seed",
		"seed:upload": "bun run --filter @geocoded/api seed:upload",
		"types": "bun run --filter @geocoded/api types",
		"test": "bun --no-env-file test",
		"check": "bun run lint:check && bun run format:check && bun run build:packages && bun run test && bun run size:check && bun run audit",
		"fix": "bun lint:fix && bun format:fix",
		"lint:check": "oxlint --type-aware --type-check --max-warnings 0",
		"lint:fix": "oxlint --type-aware --type-check --fix",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"audit": "knip",
		"hooks:install": "lefthook install",
		"hooks:validate": "lefthook validate",
		"build:packages": "tsdown && oxfmt --ignore-path=/dev/null packages/*/dist",
		"size:check": "bun scripts/check-package-size.ts",
		"release:version": "lerna version --yes",
		"release:publish": "lerna publish from-package --yes"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@lerna-lite/cli": "5.6.1",
		"@lerna-lite/publish": "5.6.1",
		"@lerna-lite/version": "5.6.1",
		"@types/bun": "^1.3.13",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"conventional-changelog-conventionalcommits": "10.4.0",
		"knip": "6.38.0",
		"lefthook": "2.1.14",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003",
		"publint": "0.3.24",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"tsdown": "0.23.0",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.2"
}
