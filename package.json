{
	"name": "geocoded",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @geocoded/site dev",
		"dev:api": "bun run --filter @geocoded/api dev",
		"build:site": "bun run --filter @geocoded/site build",
		"preview:site": "bun run --filter @geocoded/site preview",
		"deploy": "bun run --filter @geocoded/api deploy",
		"seed": "bun run --filter @geocoded/api seed",
		"seed:upload": "bun run --filter @geocoded/api seed:upload",
		"types": "bun run --filter @geocoded/api types",
		"test": "bun --no-env-file test",
		"check": "bun run lint:check && bun run format:check && bun run test && bun run audit",
		"fix": "bun lint:fix && bun format:fix",
		"lint:check": "oxlint --type-aware --type-check --max-warnings 0",
		"lint:fix": "oxlint --type-aware --type-check --fix",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt",
		"audit": "knip",
		"hooks:install": "lefthook install",
		"hooks:validate": "lefthook validate"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"knip": "6.38.0",
		"lefthook": "2.1.14",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003",
		"wrangler": "^4.86.0"
	}
}
