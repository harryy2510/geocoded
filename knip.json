{
	"$schema": "./node_modules/knip/schema.json",
	"bun": true,
	"workspaces": {
		".": {
			"entry": ["tests/**/*.ts", "scripts/*.ts"],
			"project": ["tests/**/*.ts", "scripts/*.ts"]
		},
		"apps/api": {
			"project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
		},
		"apps/site": {
			"project": ["src/**/*.{astro,css,ts,tsx}"]
		},
		"packages/*": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		}
	},
	"ignoreDependencies": [
		"@lerna-lite/publish",
		"@lerna-lite/version",
		"conventional-changelog-conventionalcommits",
		"hono",
		"wrangler"
	]
}
